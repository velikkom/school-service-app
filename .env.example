# =============================================================================
# school-service-platform - Ortam Degiskenleri Ornegi
# Bu dosyayi .env olarak kopyalayip gercek degerlerle doldurun.
# .env dosyasi GIT'E EKLENMEZ (.gitignore). Gercek secret'lari asla commit etmeyin.
# =============================================================================

# ---------- PostgreSQL (Docker Compose) ----------
POSTGRES_DB=school_service
POSTGRES_USER=school_service_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ---------- Mailpit (yerel e-posta test araci) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Backend (Spring Boot) ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/school_service
DB_USERNAME=school_service_app
DB_PASSWORD=change-me-strong-password

# JWT - en az 256 bit (32 byte) rastgele, base64 encoded secret kullanin.
# Uretmek icin (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_TTL_MINUTES=15
# "Beni hatırla" İŞARETLENMEDİĞİNDE kullanılan refresh token sunucu tavanı (bkz. docs/SECURITY.md
# "Beni hatırla") - cookie bu durumda Max-Age TAŞIMAZ (oturum çerezi), bu sadece arka plan güvenlik
# tavanıdır.
JWT_REFRESH_TOKEN_TTL_DAYS=1
# "Beni hatırla" İŞARETLENDİĞİNDE kullanılan refresh token süresi - cookie Max-Age'i BUNDAN türetilir.
JWT_REFRESH_TOKEN_TTL_DAYS_REMEMBER_ME=30

# Ilk ADMIN bootstrap (uygulama ilk ayaga kalkista, eger hic ADMIN yoksa kullanilir)
# Production'da bu degerleri gercek, guclu bir parola ile ayarlayip bir kez calistirin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMP_PASSWORD
BOOTSTRAP_ADMIN_FULL_NAME="Sistem Yoneticisi"

# CORS - izin verilen origin listesi (virgulle ayrilmis)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Swagger/OpenAPI - production'da varsayilan kapali olmali
SWAGGER_ENABLED=true

# Mail (SMTP) - yerel gelistirmede Mailpit kullanilir
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@okulservisi.local

# Sifre sifirlama e-postasindaki linkin temel yolu - frontend'deki GERCEK sayfa ile (sifre-sifirla) eslesmeli
RESET_PASSWORD_BASE_URL=http://localhost:3000/sifre-sifirla

# Kayit talebi e-posta dogrulama linkinin temel yolu - frontend'deki GERCEK sayfa ile eslesmeli
REGISTRATION_VERIFICATION_BASE_URL=http://localhost:3000/e-posta-dogrula

# ---------- Sosyal giris (OAuth2 + PKCE) ----------
# Herhangi bir saglayici icin CLIENT_ID/CLIENT_SECRET bos birakilirsa o saglayici UI'da DEVRE DISI
# gorunur (sahte/aktifmis gibi davranilmaz) - bkz. docs/SECURITY.md "Sosyal giris".
# Callback adresi (saglayici konsolunda TANIMLANMASI gereken, sabit/allowlist URI):
#   Google:   {OAUTH_REDIRECT_BASE_URL}/api/auth/social/google/callback
#   Facebook: {OAUTH_REDIRECT_BASE_URL}/api/auth/social/facebook/callback
#   X:        {OAUTH_REDIRECT_BASE_URL}/api/auth/social/x/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Google: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, "Web application")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps/ ("Facebook Login" urunu eklenmis bir App)
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# X (Twitter): https://developer.x.com/en/portal/dashboard ("OAuth 2.0" etkin bir App, PKCE zorunlu)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# BFF'in backend'in POST /api/auth/social-login uc noktasini cagirirken gonderdigi paylasilan sir
# (backend'deki app.security.internal-service-key ILE AYNI olmali) - bu endpoint dogrudan
# tarayicidan cagrilamaz, sadece BU anahtari bilen taraf (BFF) cagirabilir; bos birakilirsa backend
# bu uc noktayi HER ZAMAN reddeder (fail-closed), bkz. docs/SECURITY.md "Sosyal giris".
# Uretmek icin (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
INTERNAL_SERVICE_KEY=REPLACE_WITH_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES

# ---------- Frontend (Next.js) ----------
# BFF'in backend'e eristigi adres (sunucu tarafi, tarayiciya ifsa edilmez)
BACKEND_INTERNAL_URL=http://localhost:8080
# Next.js public taraf icin kullanilan temel yol (BFF proxy ayni origin uzerinden calisir)
NEXT_PUBLIC_APP_NAME="Okul Servisi Yonetim Sistemi"
FRONTEND_PORT=3000

# Cookie imzalama / sifreleme icin kullanilan sunucu-tarafi secret (BFF)
# Uretmek icin (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
BFF_COOKIE_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES
