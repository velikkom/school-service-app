# Bu dosyayi .env.local olarak kopyalayip gercek degerlerle doldurun (.env.local GIT'E EKLENMEZ).

# Next.js BFF'in backend'e eristigi adres (sunucu tarafi, tarayiciya acilmaz)
BACKEND_INTERNAL_URL=http://localhost:8080

# Cerez sureleri (backend JWT ayarlariyla ayni olmali)
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# CSRF token imzalama sirri (root .env'deki BFF_COOKIE_SECRET ile ayni)
# Uretmek icin (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
BFF_COOKIE_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES

# Sosyal giris (opsiyonel; bos birakilirsa butonlar gosterilmez)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
INTERNAL_SERVICE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

NEXT_PUBLIC_APP_NAME="ServisFlow"
